# Honcut Model Configuration
# Copy to .env and fill in your API keys

# Primary AI provider: Volcano Ark Agent Plan
ARK_API_KEY=ark-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=ark-code-latest

# Volcano Ark Vision (for video analysis / knowledge base)
ARK_VISION_API_KEY=
ARK_VISION_MODEL=doubao-embedding-vision

# Seedance (AI video generation)
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_MODEL=doubao-seedance-2-0-260128

# Image generation (OpenAI-compatible)
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1

# Generic LLM fallback
LLM_PROVIDER=ark
LLM_MODEL=ark-code-latest
OPENAI_API_KEY=
