# Honcut Model Configuration
# Copy to .env and fill in your API keys

# Primary: Volcano Ark Agent Plan (doubao-seed-2.0-pro)
ARK_API_KEY=ark-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=doubao-seed-2.0-pro

# Video generation: Seedance 2.0 (requires Medium+ plan)
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_MODEL=doubao-seedance-2.0

# Image generation: Seedream 5.0 Lite
SEEDREAM_MODEL=doubao-seedream-5.0-lite

# Embedding model for KB semantic search
ARK_EMBEDDING_MODEL=doubao-embedding-vision

# Voice: TTS 2.0
TTS_MODEL=doubao-seed-tts-2.0

# External providers (optional)
LLM_PROVIDER=ark
LLM_MODEL=doubao-seed-2.0-pro
OPENAI_API_KEY=
